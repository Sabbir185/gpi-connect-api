APP_NAME="GPI Connect"
PORT="8080"
ENV="dev"

DATABASE_URL=""
DB_MIGRATIONS_PATH="migrations"

REDIS_URL="localhost:6379"

SMS_NET_API_KEY=""
SMS_OTP_EXPIRE_IN_MIN=3
# false keeps OTPs out of the SMS gateway; in development the code is printed in the API log.
SMS_ENABLED=true

# Generate each with: go run ./cmd/tools/keygen
JWT_SECRET=""
OTP_SECRET=""
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Firebase service account json as base64: base64 -w0 firebase-adminsdk.json
FIREBASE_CREDENTIALS_BASE64=""

# Optional; welcome emails are skipped until both are set. The sender must be verified in Brevo.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="GPI Connect"
