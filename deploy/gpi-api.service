[Unit]
Description=GPI Connect API
After=network-online.target
Wants=network-online.target

[Service]
User=gpi
WorkingDirectory=/opt/gpi-connect-api
ExecStart=/opt/gpi-connect-api/bin/api
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=15
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
